# ====== Feeder — variáveis de ambiente ======
# Segredos e caminhos. O QUE buscar/publicar fica no config.yaml, não aqui.

# Banco de dados (SQLite no v1; path do arquivo)
DATABASE_PATH = "data/feeder.db"

# Caminho do arquivo de configuração dos grupos/fontes/sinks
CONFIG_PATH = "config.yaml"

# ====== OpenRouter (classificação via Claude Haiku) ======
OPENROUTER_API_KEY = ""
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
# Modelo barato/rápido para classificar e resumir (ver docs/adr/0003).
OPENROUTER_MODEL = "anthropic/claude-haiku-4.5"

# ====== WordPress (sink de rascunho) ======
# Usa a REST API do WP com Application Password.
WORDPRESS_URL = ""
WORDPRESS_USER = ""
WORDPRESS_APP_PASSWORD = ""
# Status com que os posts são criados (draft = rascunho p/ curadoria humana).
WORDPRESS_DEFAULT_STATUS = "draft"
